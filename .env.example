# Copia este archivo a .env y completa los valores vacíos (el .env nunca se sube).

# desarrollo: registros en texto legible · produccion: registros en JSON
IA_ENTORNO=desarrollo
IA_PUERTO=8085

# Base de reportes (modelo de lectura, 401). Usuario propio "ia" en la instancia del puerto 5433.
IA_REPORTES_DB_URL=postgresql+psycopg://ia:ia@localhost:5433/reportes_db
# Usuario de solo lectura del constructor de reportes (503): rol ia_reportes_lector (clave en infra/.env)
IA_REPORTES_DB_URL_LECTURA=postgresql+psycopg://ia_reportes_lector:<clave de ia_reportes_lector>@localhost:5433/reportes_db

# MongoDB del servicio (402, 403 y capa 5)
IA_MONGO_URL=mongodb://localhost:27017
IA_MONGO_DB=ia_db

# RabbitMQ con el usuario propio del servicio: la clave es RABBITMQ_IA_CLAVE de infra/.env
IA_RABBITMQ_URL=amqp://ia:<RABBITMQ_IA_CLAVE>@localhost:5672/

# Keycloak (validación del token)
IA_KEYCLOAK_ISSUER=http://localhost:8080/realms/supervision
IA_AUDIENCIA=plataforma-api

IA_ZONA_HORARIA=America/La_Paz

# Modelos versionados (402): carpeta y versión (vacía: la de modelos/riesgo_retraso/actual.txt)
IA_MODELOS_DIR=modelos
IA_MODELO_RIESGO_VERSION=

# Modelo de consumos atípicos (403). Vacío: la versión de modelos/consumos_atipicos/actual.txt.
IA_MODELO_ATIPICOS_VERSION=

# Modelo de lenguaje (503 y 502): ollama (por defecto) o anthropic. Otro valor: el servicio no arranca.
IA_LLM_PROVEEDOR=ollama
# Vacío: qwen3:8b con ollama, claude-sonnet-5-5 con anthropic
IA_LLM_MODELO=
IA_OLLAMA_URL=http://localhost:11434
# Clave de la API de Anthropic: solo en el .env local o en el gestor de secretos (nunca en el repositorio).
# Con IA_LLM_PROVEEDOR=anthropic y sin clave, el servicio no arranca.
IA_ANTHROPIC_API_KEY=

# Servicios (carga inicial; IA_MATERIALES_URL también para los nombres de materiales de los reportes, 503)
IA_OBRAS_URL=http://localhost:8081
IA_MATERIALES_URL=http://localhost:8082
IA_FINANZAS_URL=http://localhost:8083
IA_REPORTES_CLIENT_ID=ia-reportes
# Secreto del cliente ia-reportes en Keycloak (copiarlo de infra/.env)
IA_REPORTES_CLIENT_SECRET=

# Servidores MCP (501). Hosts que acepta el /mcp de ia-api (en Compose, agregar ia-api:8085).
IA_MCP_HOSTS_PERMITIDOS=localhost:8085,127.0.0.1:8085
# Host de los agentes (solo ia-worker): cliente confidencial ia-agentes (rol agente_ia) y los cuatro servidores MCP.
IA_AGENTES_CLIENT_ID=ia-agentes
# Secreto del cliente ia-agentes en Keycloak: solo en el .env local o en el gestor de secretos (copiarlo de infra/.env)
IA_AGENTES_CLIENT_SECRET=
IA_OBRAS_MCP_URL=http://localhost:8081/mcp
IA_MATERIALES_MCP_URL=http://localhost:8082/mcp
IA_FINANZAS_MCP_URL=http://localhost:8083/mcp
IA_PROPIO_MCP_URL=http://localhost:8085/mcp
